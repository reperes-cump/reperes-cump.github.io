---
import { getCollection, getEntry } from 'astro:content';
import type { Affirmation } from '../../schemas/index.ts';
import EncadreSilence from '../components/EncadreSilence.astro';
import EnTete from '../components/EnTete.astro';
import Legende from '../components/Legende.astro';
import Matrice from '../components/Matrice.astro';
import PiedDePage from '../components/PiedDePage.astro';
import Base from '../layouts/Base.astro';
import { lignesMatrice } from '../lib/affichage.ts';

const sources = new Map((await getCollection('sources')).map((e) => [e.id, e.data]));
const affirmations = new Map((await getCollection('affirmations')).map((e) => [e.id, e.data]));
const infos = (await getEntry('infos', 'contenu'))?.data ?? null;
const encadre = (await getEntry('visuels', 'encadre-silence'))?.data;

const requise = (id: string): Affirmation => {
  const affirmation = affirmations.get(id);
  if (!affirmation) throw new Error(`Accueil : affirmation introuvable : ${id}`);
  return affirmation;
};

const lignes = lignesMatrice(affirmations.values());
const demande = requise('circuit-demande-samu');
const grades = requise('methode-grades');
const elementsEncadre = (encadre?.elements ?? []).flatMap((e) => e.affirmations.map(requise));

const affichees = [...lignes, demande, grades, ...elementsEncadre];
const brouillon = affichees.some((a) => !a.verifie_le) || !infos?.version;
---

<Base brouillon={brouillon}>
  <EnTete demande={demande} infos={infos} sources={sources} />
  <main class="accueil">
    <div class="intro">
      <p class="intro-question">
        Pour chaque situation, ce que dit la recommandation de la SFMU (2017)&nbsp;: faut-il
        alerter le référent&#8239;? Faut-il activer la CUMP&#8239;?
      </p>
      <p class="intro-aide">Dans chaque case, «&#8239;SFMU 2017&#8239;» ouvre la source.</p>
    </div>
    <Legende grades={grades} sources={sources} brouillon={affichees.some((a) => !a.verifie_le)} />
    <Matrice lignes={lignes} sources={sources} />
    <EncadreSilence elements={elementsEncadre} sources={sources} />
  </main>
  <PiedDePage />
</Base>

<style>
  .accueil {
    display: grid;
    gap: var(--espace-5);
    padding-top: var(--espace-5);
    border-top: var(--trait) solid var(--filet);
  }

  .intro {
    display: grid;
    gap: var(--espace-1);
    max-width: var(--mesure);
  }

  .intro-question {
    font-size: var(--taille-0);
    line-height: var(--interligne-serre);
    font-weight: 650;
  }

  @media (width >= 48rem) {
    .intro-question {
      font-size: var(--taille-1);
    }
  }

  .intro-aide {
    color: var(--encre-2);
  }
</style>
