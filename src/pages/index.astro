---
import EncadreSilence from '../components/EncadreSilence.astro';
import EnTete from '../components/EnTete.astro';
import Legende from '../components/Legende.astro';
import Matrice from '../components/Matrice.astro';
import Base from '../layouts/Base.astro';
import { accueil, donnees } from '../lib/donnees.ts';

const { sources, infos } = await donnees();
const { lignes, demande, grades, elementsEncadre, affichees } = await accueil();
const nonVerifie = affichees.some((a) => !a.verifie_le);
---

<Base courante="accueil" brouillon={nonVerifie || !infos?.version} infos={infos}>
  <EnTete demande={demande} infos={infos} sources={sources} />
  <main class="accueil">
    <div class="intro">
      <p class="intro-question">
        Pour chaque situation, ce que dit la recommandation de la SFMU (2017)&nbsp;: faut-il
        alerter le référent&#8239;? Faut-il activer la CUMP&#8239;?
      </p>
      <p class="intro-aide">Dans chaque case, «&#8239;SFMU 2017&#8239;» ouvre la source.</p>
    </div>
    <Legende grades={grades} sources={sources} brouillon={nonVerifie} />
    <Matrice lignes={lignes} sources={sources} />
    <EncadreSilence elements={elementsEncadre} sources={sources} />
  </main>
</Base>

<style>
  .accueil {
    display: grid;
    gap: var(--espace-5);
    padding-top: var(--espace-5);
    border-top: var(--trait) solid var(--filet);
  }

  .intro {
    display: grid;
    gap: var(--espace-1);
    max-width: var(--mesure);
  }

  .intro-question {
    font-size: var(--taille-0);
    line-height: var(--interligne-serre);
    font-weight: 650;
  }

  @media (width >= 48rem) {
    .intro-question {
      font-size: var(--taille-1);
    }
  }

  .intro-aide {
    color: var(--encre-2);
  }
</style>
