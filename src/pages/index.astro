---
import CadreOfficiel from '../components/CadreOfficiel.astro';
import EncadreSilence from '../components/EncadreSilence.astro';
import EnTete from '../components/EnTete.astro';
import Legende from '../components/Legende.astro';
import Matrice from '../components/Matrice.astro';
import Base from '../layouts/Base.astro';
import { accueil, donnees } from '../lib/donnees.ts';

const { sources, affirmations, infos } = await donnees();
const { cadre, lignes, demande, grades, elementsEncadre, affichees } = await accueil();
const nonVerifie = affichees.some((a) => !a.verifie_le);
---

<Base courante="accueil" brouillon={nonVerifie || !infos?.version} infos={infos}>
  <EnTete demande={demande} sources={sources} />
  <main class="accueil">
    <div class="titre-matrice">
      <h2>Alerter le référent&#8239;? Activer la CUMP&#8239;?</h2>
      <p class="sous-titre">
        Ce que dit la recommandation SFMU 2017, situation par situation. Chaque case ouvre le
        passage du texte.
      </p>
    </div>
    <Legende grades={grades} sources={sources} brouillon={nonVerifie} />
    <Matrice lignes={lignes} sources={sources} affirmations={affirmations} />
    <p class="note-matrice">
      La recommandation SFMU 2017 est le seul texte consulté qui détaille les situations. Quand un
      autre texte parle de la même situation, il est signalé sous son nom.
    </p>
    <CadreOfficiel elements={cadre} sources={sources} />
    <EncadreSilence elements={elementsEncadre} sources={sources} />
  </main>
</Base>

<style>
  .accueil {
    display: grid;
    gap: var(--espace-4);
    padding-top: var(--espace-4);
    border-top: var(--trait) solid var(--filet);
  }

  .titre-matrice {
    display: grid;
    gap: var(--espace-1);
  }

  .titre-matrice h2 {
    font-size: var(--taille-1);
    line-height: var(--interligne-serre);
  }

  @media (width >= 48rem) {
    .titre-matrice h2 {
      font-size: var(--taille-2);
    }
  }

  .sous-titre,
  .note-matrice {
    max-width: var(--mesure);
    color: var(--encre-2);
  }

  .note-matrice {
    font-size: var(--taille--1);
  }
</style>
