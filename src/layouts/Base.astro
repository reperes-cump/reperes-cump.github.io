---
import { Font } from 'astro:assets';
import type { InfosContenu } from '../../schemas/index.ts';
import BandeauBrouillon from '../components/BandeauBrouillon.astro';
import EnTeteSecondaire from '../components/EnTeteSecondaire.astro';
import Glyphes from '../components/Glyphes.astro';
import PanneauSource from '../components/PanneauSource.astro';
import PiedDePage from '../components/PiedDePage.astro';
import type { PageId } from '../lib/pages.ts';
import '../styles/base.css';

interface Props {
  courante: PageId;
  titre?: string;
  description?: string;
  /** Au moins un élément de la page n'est pas vérifié. */
  brouillon: boolean;
  infos: InfosContenu | null;
}

const { courante, titre, description, brouillon, infos } = Astro.props;
const titreComplet = titre
  ? `${titre} | Repères CUMP`
  : 'Repères CUMP | En connaissance de textes.';
// Aperçu d'un lien partagé (LinkedIn, messageries) : titre court, sans l'accroche.
const titrePartage = titre ? `${titre} | Repères CUMP` : 'Repères CUMP';
// Description sobre, reprise par les moteurs de recherche et les aperçus de lien.
const descriptionSite =
  'Déclenchement de la CUMP : ce que disent les textes officiels et la recommandation de la SFMU, avec leurs sources.';
const descriptionPartage = description ?? descriptionSite;
const adresse = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={descriptionPartage} />
    <title>{titreComplet}</title>
    <link rel="canonical" href={adresse} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Repères CUMP" />
    <meta property="og:title" content={titrePartage} />
    <meta property="og:description" content={descriptionPartage} />
    <meta property="og:url" content={adresse} />
    <meta property="og:locale" content="fr_FR" />
    <!-- Icône vide : sans elle, le navigateur demande /favicon.ico hors du site (erreur 404). -->
    <link rel="icon" href="data:," />
    <Font cssVariable="--police-texte" preload />
  </head>
  <body>
    <Glyphes />
    <BandeauBrouillon visible={brouillon} />
    <div class="page">
      <EnTeteSecondaire courante={courante} />
      <slot />
      <PiedDePage courante={courante} infos={infos} />
    </div>
    <PanneauSource />
  </body>
</html>
