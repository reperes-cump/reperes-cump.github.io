---
/** Puce de source : ouvre le panneau source préparé au build (voir ContenuPanneau). */
interface Props {
  libelle: string;
  /** Identifiant du modèle de panneau à ouvrir. */
  panneau: string;
  /** « voir-aussi » : renvoi vers un autre texte, distinct des sources de la case. */
  variante?: 'voir-aussi';
}

const { libelle, panneau, variante } = Astro.props;
---

<button
  type="button"
  class:list={['puce-source', variante && `puce-${variante}`]}
  aria-haspopup="dialog"
  data-panneau={panneau}
>
  {libelle}
</button>

<style>
  .puce-source {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0.1rem var(--espace-2);
    border: var(--trait) solid currentColor;
    border-radius: var(--rayon-puce);
    background: var(--papier);
    color: var(--source);
    font-size: var(--taille--1);
    line-height: 1.2;
    text-align: start;
    cursor: pointer;
  }

  .puce-source:hover {
    background: var(--source-survol);
  }

  /* Renvoi vers un autre texte : trait en tirets, couleur discrète. */
  .puce-voir-aussi {
    border-style: dashed;
    color: var(--encre-2);
  }

  .puce-voir-aussi:hover {
    background: var(--papier-2);
  }
</style>
