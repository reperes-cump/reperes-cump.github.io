---
/**
 * Bandeau propre à la maquette : rappelle que le contenu n'est pas vérifié et
 * permet de comparer les rendus. À retirer quand l'accueil sera branché sur
 * les données.
 */
---

<div class="bandeau">
  <div class="page bandeau-interieur">
    <p class="bandeau-texte">Maquette&nbsp;: contenu non vérifié.</p>
    <div class="bandeau-reglages">
      <label class="reglage">
        <input type="checkbox" id="apercu-verifie" />
        Voir le rendu final
      </label>
      <label class="reglage">
        Thème
        <select id="choix-theme">
          <option value="">système</option>
          <option value="clair">clair</option>
          <option value="sombre">sombre</option>
        </select>
      </label>
    </div>
  </div>
</div>

<script>
  const racine = document.documentElement;

  const apercu = document.getElementById('apercu-verifie');
  if (apercu instanceof HTMLInputElement) {
    apercu.checked = false;
    apercu.addEventListener('change', () => {
      racine.toggleAttribute('data-brouillon', !apercu.checked);
    });
  }

  const theme = document.getElementById('choix-theme');
  if (theme instanceof HTMLSelectElement) {
    theme.value = '';
    theme.addEventListener('change', () => {
      if (theme.value) racine.dataset.theme = theme.value;
      else delete racine.dataset.theme;
    });
  }
</script>

<style>
  .bandeau {
    background: var(--encre);
    color: var(--papier);
    font-size: var(--taille--1);
  }

  .bandeau-interieur {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-2) var(--espace-5);
    padding-block: var(--espace-2);
  }

  .bandeau-texte {
    font-weight: 650;
  }

  .bandeau-reglages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-2) var(--espace-5);
  }

  .reglage {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-2);
    min-height: 2rem;
    cursor: pointer;
  }

  .reglage input {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    accent-color: var(--papier);
  }

  .reglage select {
    min-height: 1.75rem;
    padding-inline: var(--espace-2);
    border: var(--trait) solid var(--papier);
    border-radius: var(--rayon);
    background: var(--encre);
    color: var(--papier);
  }

  .bandeau :focus-visible {
    outline-color: var(--papier);
  }
</style>
