---
import type { Verdict } from '../../schemas/index.ts';
import { typographie } from '../lib/affichage.ts';
import { libellesGrade, libellesVerdict, phraseSilence } from '../lib/libelles.ts';
import Glyphe from './Glyphe.astro';

interface Props {
  verdict: Verdict & { valeur: Exclude<Verdict['valeur'], 'information'> };
  /** Panneau source à ouvrir : la tuile devient un bouton. */
  panneau?: string;
  /** Libellé de la source, affiché en petit dans la tuile (« SFMU 2017, p. 6 »). */
  source?: string;
}

const { verdict, panneau, source } = Astro.props;
const Balise = panneau ? 'button' : 'div';
const silence = verdict.valeur === 'silence';
const libelle = typographie(
  silence ? phraseSilence : (verdict.libelle ?? libellesVerdict[verdict.valeur]),
);
const grade = verdict.grade ? libellesGrade[verdict.grade] : null;
---

<Balise
  class:list={['tuile', 'rendu', { 'tuile-bouton': panneau }]}
  data-valeur={verdict.valeur}
  type={panneau ? 'button' : undefined}
  data-panneau={panneau}
  aria-haspopup={panneau ? 'dialog' : undefined}
>
  <span class="plaque">
    <Glyphe valeur={verdict.valeur} class="tuile-glyphe" />
    <span class="texte">
      {silence && <span class="visuellement-cache">Silence des textes : </span>}
      <span class:list={['libelle', { 'libelle-silence': silence }]}>{libelle}</span>
      {
        (grade || source) && (
          <span class="meta">
            {grade && <span class="grade">{grade}</span>}
            {source && (
              <span class="tuile-source">
                <span class="visuellement-cache">Source : </span>
                {source}
              </span>
            )}
          </span>
        )
      }
    </span>
  </span>
</Balise>

<style>
  .tuile {
    display: flex;
    align-items: flex-start;
    min-height: 4rem;
    padding: var(--espace-2) var(--espace-3);
  }

  .plaque {
    display: inline-flex;
    align-items: flex-start;
    gap: var(--espace-2);
    max-width: 100%;
    padding: var(--espace-1) var(--espace-2);
    margin: calc(-1 * var(--espace-1)) calc(-1 * var(--espace-2));
    border-radius: var(--rayon);
  }

  :global(.tuile-glyphe) {
    margin-top: 0.1em;
  }

  .texte {
    display: flex;
    flex-direction: column;
    line-height: var(--interligne-serre);
  }

  .libelle {
    font-weight: 650;
  }

  .libelle-silence {
    font-weight: 400;
  }

  /* Grade et source côte à côte quand la place le permet. */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--espace-3);
    margin-top: 0.15em;
  }

  /* Tuile-bouton : toute la case ouvre la source. */
  .tuile-bouton {
    width: 100%;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .tuile-source {
    font-size: var(--taille--1);
    font-weight: 400;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .tuile-bouton:hover .tuile-source {
    text-decoration-thickness: 2px;
  }

  .tuile-bouton:hover {
    filter: brightness(0.94);
  }
</style>
