---
import type { Affirmation, Source } from '../../schemas/index.ts';
import { typographie } from '../lib/affichage.ts';
import { colonnes, libellesAutorite, libellesVerdict } from '../lib/libelles.ts';
import CelluleVerdict from './CelluleVerdict.astro';
import Glyphe from './Glyphe.astro';
import VoirAussi from './VoirAussi.astro';

interface Props {
  lignes: Affirmation[];
  sources: Map<string, Source>;
  /** Toutes les informations : pour les renvois « voir aussi » vers d'autres textes. */
  affirmations: Map<string, Affirmation>;
}

const { lignes, sources, affirmations } = Astro.props;

const valeursLigne = (l: Affirmation) =>
  l.fusion
    ? { alerte: l.fusion.valeur, activation: l.fusion.valeur }
    : { alerte: l.verdicts?.alerte.valeur, activation: l.verdicts?.activation.valeur };
const autoritesLigne = (l: Affirmation) => [
  ...new Set(l.sources.flatMap((r) => sources.get(r.source_id)?.autorite ?? [])),
];

// Filtres : seulement les verdicts présents, et l'autorité seulement s'il y en a plusieurs.
const ordreVerdicts = [
  'recommande',
  'deconseille',
  'pas_de_consensus',
  'pas_de_conclusion',
  'silence',
] as const;
const presents = new Set(lignes.flatMap((l) => Object.values(valeursLigne(l))));
const verdictsFiltre = ordreVerdicts.filter((v) => presents.has(v));
const autorites = [...new Set(lignes.flatMap(autoritesLigne))];
const modes = [
  { valeur: 'deux', libelle: 'Alerter et activer' },
  { valeur: 'alerte', libelle: colonnes.alerte.court },
  { valeur: 'activation', libelle: colonnes.activation.court },
];
---

<div class="conteneur-matrice" data-matrice>
  <div class="filtres" data-filtres hidden>
    <label class="recherche">
      <span class="visuellement-cache">Rechercher une situation</span>
      <input
        type="search"
        name="recherche"
        placeholder="Rechercher une situation (suicide, nourrisson…)"
        autocomplete="off"
        enterkeyhint="search"
      />
    </label>
    <fieldset class="bascule">
      <legend class="visuellement-cache">Colonnes affichées</legend>
      {
        modes.map((mode, index) => (
          <label class="bascule-option">
            <input type="radio" name="colonnes" value={mode.valeur} checked={index === 0} />
            <span>{mode.libelle}</span>
          </label>
        ))
      }
    </fieldset>
    <details class="filtre-details">
      <summary>Filtrer</summary>
      <div class="filtre-corps">
        <fieldset class="filtre-groupe">
          <legend>Position</legend>
          {
            verdictsFiltre.map((valeur) => (
              <label class="filtre-option">
                <input type="checkbox" name="verdict" value={valeur} checked />
                <Glyphe valeur={valeur} />
                <span>{libellesVerdict[valeur]}</span>
              </label>
            ))
          }
        </fieldset>
        {
          autorites.length > 1 && (
            <fieldset class="filtre-groupe">
              <legend>Autorité</legend>
              {autorites.map((autorite) => (
                <label class="filtre-option">
                  <input type="checkbox" name="autorite" value={autorite} checked />
                  <span>{libellesAutorite[autorite]}</span>
                </label>
              ))}
            </fieldset>
          )
        }
        <button type="button" class="filtre-tout" data-tout>Tout afficher</button>
      </div>
    </details>
    <p class="filtre-resultat" aria-live="polite" data-resultat></p>
  </div>

  <table class="matrice" role="table" data-colonnes="deux">
    <caption class="visuellement-cache">
      Alerter le référent, activer la CUMP : position de la recommandation SFMU 2017 pour chaque
      situation
    </caption>
    <thead role="rowgroup">
      <tr role="row">
        <th scope="col" role="columnheader">Situation</th>
        <th scope="col" role="columnheader" data-colonne="alerte">{colonnes.alerte.titre}</th>
        <th scope="col" role="columnheader" data-colonne="activation">
          {colonnes.activation.titre}
        </th>
      </tr>
    </thead>
    <tbody role="rowgroup">
      {
        lignes.map((ligne) => (
          <tr
            role="row"
            id={`situation-${ligne.critere_explorateur}`}
            data-alerte={valeursLigne(ligne).alerte}
            data-activation={valeursLigne(ligne).activation}
            data-autorites={autoritesLigne(ligne).join(' ')}
          >
            <th scope="row" role="rowheader">
              {typographie(ligne.situation ?? '')}
              <VoirAussi
                porteur={ligne}
                titre={ligne.situation ?? ''}
                affirmations={affirmations}
                sources={sources}
              />
            </th>
            {ligne.fusion ? (
              <CelluleVerdict ligne={ligne} colonne="fusion" sources={sources} />
            ) : (
              <>
                <CelluleVerdict ligne={ligne} colonne="alerte" sources={sources} />
                <CelluleVerdict ligne={ligne} colonne="activation" sources={sources} />
              </>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="filtre-vide" data-vide hidden>Aucune situation ne correspond.</p>
</div>

<script>
  for (const racine of document.querySelectorAll<HTMLElement>('[data-matrice]')) {
    const filtres = racine.querySelector<HTMLElement>('[data-filtres]');
    const table = racine.querySelector<HTMLTableElement>('table');
    const corps = table?.tBodies[0];
    const resultat = racine.querySelector<HTMLElement>('[data-resultat]');
    const vide = racine.querySelector<HTMLElement>('[data-vide]');
    if (!filtres || !table || !corps) continue;

    const coches = (nom: string) =>
      new Set(
        [...filtres.querySelectorAll<HTMLInputElement>(`input[name="${nom}"]:checked`)].map(
          (champ) => champ.value,
        ),
      );
    const autoritesFiltrees = filtres.querySelector('input[name="autorite"]') !== null;
    const recherche = filtres.querySelector<HTMLInputElement>('input[name="recherche"]');
    // Recherche sans accents ni majuscules : « deces » trouve « Décès ».
    const simple = (texte: string) =>
      texte.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
    const textes = new Map(
      [...corps.rows].map((ligne) => [ligne, simple(ligne.cells[0]?.textContent ?? '')]),
    );

    const appliquer = () => {
      const mode =
        filtres.querySelector<HTMLInputElement>('input[name="colonnes"]:checked')?.value ?? 'deux';
      const verdicts = coches('verdict');
      const autorites = coches('autorite');
      const mots = simple(recherche?.value ?? '')
        .split(/\s+/)
        .filter(Boolean);
      table.dataset.colonnes = mode;
      for (const cellule of table.querySelectorAll<HTMLTableCellElement>(
        'td[data-colonne="fusion"]',
      )) {
        cellule.colSpan = mode === 'deux' ? 2 : 1;
      }

      let visibles = 0;
      for (const ligne of corps.rows) {
        const valeurs =
          mode === 'deux'
            ? [ligne.dataset.alerte, ligne.dataset.activation]
            : [mode === 'alerte' ? ligne.dataset.alerte : ligne.dataset.activation];
        const verdictRetenu = valeurs.some((v) => v !== undefined && verdicts.has(v));
        const autoriteRetenue =
          !autoritesFiltrees ||
          (ligne.dataset.autorites ?? '').split(' ').some((a) => autorites.has(a));
        const texteRetenu = mots.every((mot) => textes.get(ligne)?.includes(mot));
        ligne.hidden = !(verdictRetenu && autoriteRetenue && texteRetenu);
        if (!ligne.hidden) visibles += 1;
      }

      const total = corps.rows.length;
      if (resultat) {
        resultat.textContent =
          visibles === total ? '' : `${visibles} situation${visibles > 1 ? 's' : ''} sur ${total}`;
      }
      if (vide) vide.hidden = visibles > 0;
    };

    filtres.addEventListener('change', appliquer);
    recherche?.addEventListener('input', appliquer);
    filtres.querySelector('[data-tout]')?.addEventListener('click', () => {
      for (const champ of filtres.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) {
        champ.checked = true;
      }
      if (recherche) recherche.value = '';
      appliquer();
    });
    filtres.hidden = false;
    appliquer();
  }
</script>

<style>
  /* Les cellules <td> sont rendues par CelluleVerdict : d'où les sélecteurs :global(td). */
  .conteneur-matrice {
    container-type: inline-size;
    display: grid;
    gap: var(--espace-3);
  }

  /* Filtres */
  .filtres {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--espace-2) var(--espace-4);
  }

  .filtres[hidden],
  .filtre-vide[hidden] {
    display: none;
  }

  /* Recherche et bascule sur une même ligne quand la place le permet. */
  .recherche {
    flex: 1 1 18rem;
    max-width: 28rem;
  }

  .recherche input {
    width: 100%;
    max-width: 28rem;
    min-height: 2.75rem;
    padding: var(--espace-2) var(--espace-3);
    border: var(--trait) solid var(--encre-2);
    border-radius: var(--rayon);
    background: var(--papier);
    color: var(--encre);
    font: inherit;
  }

  .recherche input::placeholder {
    color: var(--encre-2);
    opacity: 1;
  }

  .bascule {
    display: inline-flex;
    margin: 0;
    padding: 2px;
    border: var(--trait) solid var(--encre-2);
    border-radius: var(--rayon-puce);
  }

  .bascule-option {
    position: relative;
  }

  .bascule-option input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .bascule-option span {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 var(--espace-3);
    border-radius: var(--rayon-puce);
    font-size: var(--taille--1);
  }

  .bascule-option input:checked + span {
    background: var(--encre);
    color: var(--papier);
    font-weight: 650;
  }

  .bascule-option input:focus-visible + span {
    outline: 3px solid var(--source);
    outline-offset: 2px;
  }

  .filtre-details summary {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--source);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .filtre-corps {
    display: grid;
    gap: var(--espace-3);
    margin-top: var(--espace-2);
    padding: var(--espace-3) var(--espace-4);
    border-radius: var(--rayon);
    background: var(--papier-2);
  }

  .filtre-groupe {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-1) var(--espace-4);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .filtre-groupe legend {
    width: 100%;
    margin-bottom: var(--espace-1);
    color: var(--encre-2);
    font-size: var(--taille--1);
  }

  .filtre-option {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-2);
    min-height: 2rem;
    cursor: pointer;
  }

  .filtre-option input {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    accent-color: var(--encre);
  }

  .filtre-tout {
    justify-self: start;
    min-height: 2rem;
    padding: 0 var(--espace-3);
    border: var(--trait) solid var(--encre);
    border-radius: var(--rayon);
    background: var(--papier);
    font-size: var(--taille--1);
    cursor: pointer;
  }

  .filtre-resultat {
    align-self: center;
    color: var(--encre-2);
    font-size: var(--taille--1);
  }

  .filtre-vide {
    padding: var(--espace-4) 0;
    color: var(--encre-2);
  }

  /* Tableau */
  .matrice {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
  }

  thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: var(--espace-3) var(--espace-3) var(--espace-2);
    border-bottom: var(--trait-fort) solid var(--encre);
    background: var(--papier);
    font-size: var(--taille-0);
    font-weight: 700;
    text-align: start;
    vertical-align: bottom;
  }

  thead th:first-child {
    padding-inline-start: 0;
    width: 38%;
  }

  thead th:not(:first-child) {
    width: 31%;
  }

  .matrice:not([data-colonnes="deux"]) thead th:first-child {
    width: 50%;
  }

  .matrice[data-colonnes="alerte"] :global([data-colonne="activation"]),
  .matrice[data-colonnes="activation"] :global([data-colonne="alerte"]) {
    display: none;
  }

  .matrice tbody tr[hidden] {
    display: none;
  }

  tbody th,
  tbody :global(td) {
    padding: var(--espace-2) var(--espace-2) var(--espace-3);
    border-bottom: var(--trait) solid var(--filet);
    vertical-align: top;
  }

  tbody th {
    padding-inline: 0 var(--espace-4);
    padding-top: calc(var(--espace-2) + var(--espace-3));
    font-weight: 400;
    text-align: start;
  }

  .matrice :global(.etiquette-colonne) {
    display: none;
  }

  /* Petit conteneur : une situation par bloc, deux verdicts côte à côte. */
  @container (width < 40rem) {
    .matrice,
    .matrice tbody,
    .matrice tr,
    .matrice th,
    .matrice :global(td) {
      display: block;
    }

    .matrice thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .matrice tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--espace-2);
      padding-block: var(--espace-4);
      border-bottom: var(--trait) solid var(--filet);
    }

    .matrice:not([data-colonnes="deux"]) tbody tr {
      grid-template-columns: minmax(0, 1fr);
    }

    .matrice tbody tr[hidden] {
      display: none;
    }

    .matrice tbody th,
    .matrice tbody :global(td) {
      padding: 0;
      border: 0;
    }

    .matrice tbody th {
      grid-column: 1 / -1;
      font-weight: 650;
    }

    .matrice :global(td[data-colonne="fusion"]) {
      grid-column: 1 / -1;
    }

    .matrice[data-colonnes="alerte"] :global([data-colonne="activation"]),
    .matrice[data-colonnes="activation"] :global([data-colonne="alerte"]) {
      display: none;
    }

    .matrice :global(.cadre-verification) {
      padding: 3px;
    }

    .matrice :global(.tuile) {
      min-height: 3.5rem;
      padding: var(--espace-2);
      font-size: 0.9375rem;
    }

    .matrice :global(.plaque) {
      gap: 0.375rem;
      padding: 2px var(--espace-1);
      margin: -2px calc(-1 * var(--espace-1));
    }

    .matrice :global(.tuile-glyphe) {
      width: 1.1em;
      height: 1.1em;
    }

    .matrice :global(.etiquette-colonne) {
      display: block;
      margin-block-end: var(--espace-1);
      color: var(--encre-2);
      font-size: var(--taille--1);
    }
  }
</style>
