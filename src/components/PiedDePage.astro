---
/** Pied de page commun : navigation, avertissement permanent, état du contenu, mentions. */
import type { InfosContenu } from '../../schemas/index.ts';
import { etatContenu } from '../lib/affichage.ts';
import { chemin } from '../lib/chemins.ts';
import { type PageId, pagesSite } from '../lib/pages.ts';

interface Props {
  courante: PageId;
  infos: InfosContenu | null;
}

const { courante, infos } = Astro.props;
---

<footer class="pied">
  <nav aria-label="Pages du site">
    <ul class="pages">
      {
        courante !== 'accueil' && (
          <li>
            <a href={chemin()}>Accueil</a>
          </li>
        )
      }
      {
        pagesSite.map((page) => (
          <li>
            {page.chemin ? (
              <a href={chemin(page.chemin)} aria-current={page.id === courante ? 'page' : undefined}>
                {page.titre}
              </a>
            ) : (
              <>
                <span class="page-a-venir">{page.titre}</span>
                <span class="a-venir">à venir</span>
              </>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mentions">
    <p class="avertissement">
      Outil d'information. Il ne remplace ni la régulation médicale du SAMU-Centre&nbsp;15 ni la
      décision du référent CUMP.
    </p>
    <p>{etatContenu(infos)}</p>
    <p>
      Projet indépendant, non affilié à la SFMU, à l'AFORCUMP-SFP, au ministère chargé de la santé,
      à une ARS ni à un établissement de santé.
    </p>
    <p>
      Code sous licence MIT&nbsp;; contenu et données sous licence CC&nbsp;BY&nbsp;4.0
      (réutilisation libre avec mention de la source). Les extraits cités restent soumis aux droits
      de leurs auteurs.
    </p>
  </div>
</footer>

<style>
  .pied {
    display: grid;
    gap: var(--espace-5);
    margin-top: var(--espace-7);
    padding-block: var(--espace-5) var(--espace-7);
    border-top: var(--trait-fort) solid var(--encre);
  }

  .pages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-3) var(--espace-6);
  }

  .pages li {
    display: flex;
    align-items: baseline;
    gap: var(--espace-2);
  }

  .pages a,
  .page-a-venir {
    font-weight: 650;
  }

  .pages a[aria-current="page"] {
    color: var(--encre);
    text-decoration: none;
  }

  .a-venir {
    color: var(--encre-2);
    font-size: var(--taille--1);
  }

  .mentions {
    display: grid;
    gap: var(--espace-2);
    max-width: var(--mesure);
    color: var(--encre-2);
    font-size: var(--taille--1);
  }

  .mentions .avertissement {
    color: var(--encre);
    font-weight: 650;
  }
</style>
