---
/**
 * Panneau source commun à tout le site : un seul <dialog>. À l'ouverture, il recopie le
 * contenu préparé au build pour la puce activée (voir ContenuPanneau).
 * Volet latéral sur grand écran, volet bas sur petit écran.
 */
---

<dialog id="panneau-source" class="panneau" aria-labelledby="panneau-titre">
  <div class="panneau-corps">
    <div class="panneau-entete">
      <h2 id="panneau-titre" class="panneau-titre" tabindex="-1">Source</h2>
      <button type="button" class="panneau-fermer" data-fermer>Fermer</button>
    </div>
    <div class="panneau-contenu" data-contenu></div>
  </div>
</dialog>

<script>
  const panneau = document.getElementById('panneau-source');
  const zone = panneau?.querySelector('[data-contenu]');
  const titre = panneau?.querySelector<HTMLElement>('#panneau-titre');

  if (panneau instanceof HTMLDialogElement && zone) {
    let declencheur: HTMLElement | null = null;

    /** Ouvre le panneau avec le contenu préparé `id` ; le focus revient ensuite à `source`. */
    const ouvrir = (id: string, source: HTMLElement) => {
      const modele = document.getElementById(id);
      if (!(modele instanceof HTMLTemplateElement)) return false;
      if (titre) titre.textContent = modele.dataset.titre ?? 'Source';
      zone.replaceChildren(modele.content.cloneNode(true));
      declencheur = source;
      panneau.showModal();
      titre?.focus();
      return true;
    };

    document.addEventListener('click', (evenement) => {
      if (!(evenement.target instanceof Element)) return;
      const puce = evenement.target.closest<HTMLElement>('[data-panneau]');
      if (!puce?.dataset.panneau) return;
      // Sans JavaScript, un lien mène à sa cible ; avec, il ouvre le panneau.
      if (ouvrir(puce.dataset.panneau, puce)) evenement.preventDefault();
    });

    // Ouverture demandée par un autre script (recherche d'un département, par exemple).
    document.addEventListener('panneau:ouvrir', (evenement) => {
      const id = (evenement as CustomEvent<string>).detail;
      if (evenement.target instanceof HTMLElement) ouvrir(id, evenement.target);
    });

    panneau.querySelector('[data-fermer]')?.addEventListener('click', () => panneau.close());

    // Un clic sur le voile, hors du contenu, ferme le panneau.
    panneau.addEventListener('click', (evenement) => {
      if (evenement.target === panneau) panneau.close();
    });

    panneau.addEventListener('close', () => {
      declencheur?.focus();
      declencheur = null;
    });
  }
</script>

<style>
  .panneau {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(30rem, 100vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-inline-start: var(--trait) solid var(--filet);
    background: var(--papier);
    color: var(--encre);
    overflow: hidden;
    transition: transform var(--duree) var(--courbe);
  }

  @starting-style {
    .panneau[open] {
      transform: translateX(100%);
    }
  }

  .panneau::backdrop {
    background: var(--voile);
  }

  @media (width < 40rem) {
    .panneau {
      inset: auto 0 0 0;
      width: 100%;
      height: auto;
      max-height: 88dvh;
      border-inline-start: 0;
      border-top: var(--trait) solid var(--filet);
      border-radius: 12px 12px 0 0;
    }

    @starting-style {
      .panneau[open] {
        transform: translateY(100%);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panneau {
      transition: none;
    }
  }

  .panneau-corps {
    display: grid;
    align-content: start;
    gap: var(--espace-5);
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--espace-5) var(--espace-5) var(--espace-6);
  }

  @media (width < 40rem) {
    .panneau-corps {
      height: auto;
      max-height: 88dvh;
    }
  }

  .panneau-entete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-4);
  }

  .panneau-titre {
    font-size: var(--taille-1);
  }

  .panneau-titre:focus {
    outline: none;
  }

  .panneau-fermer {
    min-height: 2.25rem;
    padding: var(--espace-1) var(--espace-3);
    border: var(--trait) solid var(--encre);
    border-radius: var(--rayon);
    background: var(--papier);
    cursor: pointer;
  }

  .panneau-fermer:hover {
    background: var(--papier-2);
  }

  .panneau-contenu {
    display: grid;
    gap: var(--espace-5);
  }
</style>
