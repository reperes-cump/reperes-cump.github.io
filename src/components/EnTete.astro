---
/**
 * Bande d'accueil, sous la barre : l'avertissement permanent et la règle « toute demande passe
 * par le SAMU-Centre 15 », avec sa source. Le reste (circuit, version) est dans le menu et le pied.
 */
import type { Affirmation, Source } from '../../schemas/index.ts';
import { typographie } from '../lib/affichage.ts';
import Provenance from './Provenance.astro';

interface Props {
  /** Affirmation « toute demande s'adresse au SAMU-Centre 15 ». */
  demande: Affirmation;
  sources: Map<string, Source>;
}

const { demande, sources } = Astro.props;
---

<div class="bande">
  <p class="avertissement">
    Outil d'information. Il ne remplace ni la régulation médicale du SAMU-Centre&nbsp;15 ni la
    décision du référent CUMP.
  </p>
  <div
    id="demande-samu"
    class:list={['cadre-verification', 'demande', { 'non-verifie': !demande.verifie_le }]}
  >
    <p>{typographie(demande.enonce ?? '')}</p>
    <Provenance affirmation={demande} sources={sources} titre={demande.enonce ?? ''} />
  </div>
</div>

<style>
  .bande {
    display: grid;
    gap: var(--espace-2) var(--espace-6);
    padding-block: var(--espace-3);
    font-size: var(--taille--1);
  }

  @media (width >= 60rem) {
    .bande {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  .avertissement {
    font-weight: 650;
  }

  .demande {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espace-1) var(--espace-2);
    padding: var(--espace-1) var(--espace-2);
    margin-inline: calc(-1 * var(--espace-2));
  }
</style>
