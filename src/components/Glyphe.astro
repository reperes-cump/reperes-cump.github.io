---
import type { Verdict } from '../../schemas/index.ts';

interface Props {
  /** Les verdicts « information » n'ont pas de glyphe. */
  valeur: Exclude<Verdict['valeur'], 'information'>;
  class?: string;
}

const { valeur, class: classe } = Astro.props;
---

<svg class:list={['glyphe', classe]} aria-hidden="true" focusable="false">
  <use href={`#glyphe-${valeur}`}></use>
</svg>

<style>
  .glyphe {
    flex: none;
    width: 1.25em;
    height: 1.25em;
  }
</style>
