---
import type { Affirmation, Source } from '../../schemas/index.ts';
import { paragraphes, typographie } from '../lib/affichage.ts';
import { explicationsVerdict, libellesVerdict } from '../lib/libelles.ts';
import Glyphe from './Glyphe.astro';
import Provenance from './Provenance.astro';

interface Props {
  /** Affirmation qui explique les grades (catégorie « methode »). */
  grades: Affirmation;
  sources: Map<string, Source>;
  /** Montrer l'entrée « Cadre en tirets » : au moins un élément de la page n'est pas vérifié. */
  brouillon: boolean;
}

const { grades, sources, brouillon } = Astro.props;
const valeurs = [
  'recommande',
  'deconseille',
  'pas_de_consensus',
  'pas_de_conclusion',
  'silence',
] as const;
---

<section class="legende" aria-labelledby="legende-titre">
  <h2 id="legende-titre" class="legende-titre">Comment lire le tableau</h2>

  <ul class="legende-liste">
    {
      valeurs.map((valeur) => (
        <li class="entree">
          <span class="pastille rendu" data-valeur={valeur}>
            <span class="plaque">
              <Glyphe valeur={valeur} />
            </span>
          </span>
          <span class="entree-texte">
            <span class="entree-nom">{libellesVerdict[valeur]}</span>
            {explicationsVerdict[valeur] && (
              <span class="entree-explication">{explicationsVerdict[valeur]}</span>
            )}
          </span>
        </li>
      ))
    }
    {
      brouillon && (
        <li class="entree">
          <span class="pastille pastille-brouillon" aria-hidden="true" />
          <span class="entree-texte">
            <span class="entree-nom">Cadre en tirets</span>
            <span class="entree-explication">pas encore vérifié sur le texte</span>
          </span>
        </li>
      )
    }
  </ul>

  <details class="grades">
    <summary>Que veulent dire «&#8239;accord fort&#8239;» et «&#8239;accord relatif&#8239;»&#8239;?</summary>
    <div class:list={['cadre-verification', 'grades-corps', { 'non-verifie': !grades.verifie_le }]}>
      {paragraphes(grades.enonce ?? '').map((texte) => <p>{typographie(texte)}</p>)}
      {grades.note_publique && <p>{typographie(grades.note_publique)}</p>}
      <Provenance affirmation={grades} sources={sources} titre="Accord fort, accord relatif" />
    </div>
  </details>
</section>

<style>
  .legende {
    display: grid;
    gap: var(--espace-4);
  }

  .legende-titre {
    font-size: var(--taille-0);
  }

  .legende-liste {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--espace-2) var(--espace-5);
  }

  @media (width >= 48rem) {
    .legende-liste {
      row-gap: var(--espace-3);
    }
  }

  .entree {
    display: flex;
    align-items: flex-start;
    gap: var(--espace-3);
  }

  .entree-texte {
    display: flex;
    flex-direction: column;
    padding-top: 0.2rem;
    line-height: var(--interligne-serre);
  }

  .entree-nom {
    font-weight: 650;
  }

  .entree-explication {
    margin-top: 0.2em;
    color: var(--encre-2);
    font-size: var(--taille--1);
  }

  .pastille {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 1.75rem;
  }

  .pastille .plaque {
    display: inline-flex;
    padding: 1px;
    border-radius: var(--rayon);
  }

  .pastille-brouillon {
    border: 1.5px dashed var(--encre-2);
    border-radius: 4px;
  }

  .grades {
    max-width: var(--mesure);
  }

  .grades summary {
    width: fit-content;
    color: var(--source);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .grades-corps {
    gap: var(--espace-3);
    margin-top: var(--espace-3);
    padding: var(--espace-4);
    background: var(--papier-2);
  }
</style>
